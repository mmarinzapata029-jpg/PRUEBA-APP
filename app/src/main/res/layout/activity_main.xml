<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout responsivo:
    - El fondo es un nine-patch (@drawable/bg_clouds_android), por lo que se
      estira para llenar cualquier tamaño de pantalla sin deformar al
      androide (zona protegida dentro del .9.png).
    - Los elementos (título y botón) se posicionan con "bias" porcentual de
      ConstraintLayout, de modo que mantienen su proporción relativa sin
      importar el tamaño ni la orientación de la pantalla.
    - Los tamaños de texto/botón se toman de dimens.xml, que tiene
      variantes para teléfonos (values), tablets de 7" (values-sw600dp) y
      tablets/pantallas grandes de 10" o más (values-sw720dp).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_clouds_android">

    <TextView
        android:id="@+id/txtWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_title"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="@dimen/title_text_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnEnter"
        app:layout_constraintVertical_bias="0.30"
        app:layout_constraintVertical_chainStyle="packed" />

    <Button
        android:id="@+id/btnEnter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/button_min_width"
        android:text="@string/enter_button"
        android:textSize="@dimen/button_text_size"
        android:textColor="@color/white"
        android:background="@drawable/button_outline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtWelcome"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
